# Local backend configuration
# Copy this file to .env and replace placeholder values.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mlfastapi
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/mlfastapi
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
HF_Token=replace-with-your-hugging-face-token
HF_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
# Leave empty so Hugging Face selects a compatible inference provider.
HF_PROVIDER=
CORS_ORIGINS=http://localhost:4200
